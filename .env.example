# Real Telegram authorization is enabled by default. Set to true only for UI demos.
DEMO_MODE=false

# Application JSON event-log level. The run.sh --log-level option overrides this value.
LOG_LEVEL=INFO

# Network interface that publishes the web UI. Use 127.0.0.1 for local-only access.
HOST_BIND=0.0.0.0

# Vite development server origin only. The production container serves the UI itself.
CORS_ORIGINS=http://localhost:5173
